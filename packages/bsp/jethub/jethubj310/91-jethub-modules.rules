# Identity based names for JetHome USB-UART modules.

ACTION=="remove", GOTO="jethub_modules_end"

SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea60", \
	ATTR{manufacturer}=="JetHome", ENV{ID_MM_DEVICE_IGNORE}="1"

SUBSYSTEM!="tty", GOTO="jethub_modules_end"
KERNEL!="ttyUSB[0-9]*", GOTO="jethub_modules_end"

ATTRS{idVendor}!="10c4", GOTO="jethub_modules_end"
ATTRS{idProduct}!="ea60", GOTO="jethub_modules_end"
ATTRS{manufacturer}!="JetHome", GOTO="jethub_modules_end"

ENV{ID_MM_PORT_IGNORE}="1"

ATTRS{product}=="JetHome Zigbee*", ENV{JETHUB_MODULE}="zigbee"

ENV{JETHUB_MODULE}=="", GOTO="jethub_modules_end"

ENV{JETHUB_UXM_SLOT}=="", GOTO="jethub_modules_end"
SYMLINK+="jethub/$env{JETHUB_MODULE}-slot$env{JETHUB_UXM_SLOT}"

GROUP="dialout", MODE="0660"

LABEL="jethub_modules_end"
