[Unit]
Description=JetHub GPIO to MQTT
After=jethub-initer.service mosquitto.service
Wants=mosquitto.service

[Service]
ExecStartPre=/usr/bin/python3 /usr/local/lib/gpio2mqtt/gpio-unexport.py /etc/gpio2mqtt/config.yaml
ExecStart=/usr/local/bin/gpio2mqtt --config /etc/gpio2mqtt/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
