From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Wed, 14 Oct 2026 11:31:39 +0300
Subject: [PATCH 503/506] dt-bindings: clock: add Amlogic S7 peripherals clock
 controller

Add DT bindings for the peripherals clock controller of the Amlogic S7
SoC family (S805X3, S905Y5).

The fixed PLL outputs, the GP0, GP1 and HiFi PLLs are inputs: the
fixed PLL, GP0 and the HiFi PLLs sit in a separate register region, and
GP1 belongs to the firmware.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 .../clock/amlogic,s7-peripherals-clkc.yaml    | 100 ++++++++++
 .../clock/amlogic,s7-peripherals-clkc.h       | 179 ++++++++++++++++++
 2 files changed, 279 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml
 create mode 100644 include/dt-bindings/clock/amlogic,s7-peripherals-clkc.h

diff --git a/Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml
new file mode 100644
index 000000000..2d773df26
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,s7-peripherals-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S7 Peripherals Clock Controller
+
+maintainers:
+  - Neil Armstrong <neil.armstrong@linaro.org>
+  - Jerome Brunet <jbrunet@baylibre.com>
+  - Viacheslav Bocharov <v@baodeep.com>
+
+properties:
+  compatible:
+    const: amlogic,s7-peripherals-clkc
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+  clocks:
+    minItems: 11
+    items:
+      - description: input oscillator
+      - description: input fclk div 2
+      - description: input fclk div 2p5
+      - description: input fclk div 3
+      - description: input fclk div 4
+      - description: input fclk div 5
+      - description: input fclk div 7
+      - description: input hifi pll
+      - description: input hifi1 pll
+      - description: input gp0 pll
+      - description: input gp1 pll
+      - description: external pad input for rtc (optional)
+
+  clock-names:
+    minItems: 11
+    items:
+      - const: xtal
+      - const: fdiv2
+      - const: fdiv2p5
+      - const: fdiv3
+      - const: fdiv4
+      - const: fdiv5
+      - const: fdiv7
+      - const: hifi
+      - const: hifi1
+      - const: gp0
+      - const: gp1
+      - const: ext_rtc
+
+required:
+  - compatible
+  - '#clock-cells'
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,s7-pll-clkc.h>
+    #include <dt-bindings/clock/amlogic,s7-scmi-clkc.h>
+    apb {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        clock-controller@0 {
+            compatible = "amlogic,s7-peripherals-clkc";
+            reg = <0 0x0 0 0x49c>;
+            #clock-cells = <1>;
+            clocks = <&xtal>,
+                     <&clkc_pll CLKID_FCLK_DIV2>,
+                     <&clkc_pll CLKID_FCLK_DIV2P5>,
+                     <&clkc_pll CLKID_FCLK_DIV3>,
+                     <&clkc_pll CLKID_FCLK_DIV4>,
+                     <&clkc_pll CLKID_FCLK_DIV5>,
+                     <&clkc_pll CLKID_FCLK_DIV7>,
+                     <&clkc_pll CLKID_HIFI_PLL>,
+                     <&clkc_pll CLKID_HIFI1_PLL>,
+                     <&clkc_pll CLKID_GP0_PLL>,
+                     <&scmi_clk CLKID_GP1_PLL>;
+            clock-names = "xtal",
+                          "fdiv2",
+                          "fdiv2p5",
+                          "fdiv3",
+                          "fdiv4",
+                          "fdiv5",
+                          "fdiv7",
+                          "hifi",
+                          "hifi1",
+                          "gp0",
+                          "gp1";
+        };
+    };
diff --git a/include/dt-bindings/clock/amlogic,s7-peripherals-clkc.h b/include/dt-bindings/clock/amlogic,s7-peripherals-clkc.h
new file mode 100644
