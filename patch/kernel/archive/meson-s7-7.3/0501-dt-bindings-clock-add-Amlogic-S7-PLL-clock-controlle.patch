From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Wed, 14 Oct 2026 15:03:33 +0300
Subject: [PATCH 501/506] dt-bindings: clock: add Amlogic S7 PLL clock
 controller

The S7 PLL controller provides the fixed PLL with its dividers and the
GP0 and HiFi PLLs. Its reference oscillator comes from the firmware
through SCMI. The register range covers the whole ANACTRL PLL block.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 .../bindings/clock/amlogic,s7-pll-clkc.yaml   | 55 +++++++++++++++++++
 .../dt-bindings/clock/amlogic,s7-pll-clkc.h   | 33 +++++++++++
 2 files changed, 88 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml
 create mode 100644 include/dt-bindings/clock/amlogic,s7-pll-clkc.h

diff --git a/Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml
new file mode 100644
index 000000000..370760749
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,s7-pll-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S7 PLL Clock Controller
+
+maintainers:
+  - Neil Armstrong <neil.armstrong@linaro.org>
+  - Jerome Brunet <jbrunet@baylibre.com>
+  - Viacheslav Bocharov <v@baodeep.com>
+
+properties:
+  compatible:
+    const: amlogic,s7-pll-clkc
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+  clocks:
+    items:
+      - description: PLL reference oscillator, gated by the firmware
+
+  clock-names:
+    items:
+      - const: top
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,s7-scmi-clkc.h>
+    apb {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        clock-controller@8000 {
+            compatible = "amlogic,s7-pll-clkc";
+            reg = <0 0x8000 0 0x1e8>;
+            #clock-cells = <1>;
+            clocks = <&scmi_clk CLKID_TOP_PLL_OSC>;
+            clock-names = "top";
+        };
+    };
diff --git a/include/dt-bindings/clock/amlogic,s7-pll-clkc.h b/include/dt-bindings/clock/amlogic,s7-pll-clkc.h
new file mode 100644
index 000000000..947a6a22c
--- /dev/null
+++ b/include/dt-bindings/clock/amlogic,s7-pll-clkc.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR MIT) */
+/*
+ * Copyright (c) 2026 JetHome
+ */
+
+#ifndef __S7_PLL_CLKC_H
+#define __S7_PLL_CLKC_H
+
+#define CLKID_FIXED_PLL_DCO		0
+#define CLKID_FIXED_PLL			1
+#define CLKID_FCLK_DIV2_DIV		2
+#define CLKID_FCLK_DIV2			3
+#define CLKID_FCLK_DIV2P5_DIV		4
+#define CLKID_FCLK_DIV2P5		5
+#define CLKID_FCLK_DIV3_DIV		6
+#define CLKID_FCLK_DIV3			7
+#define CLKID_FCLK_DIV4_DIV		8
+#define CLKID_FCLK_DIV4			9
+#define CLKID_FCLK_DIV5_DIV		10
+#define CLKID_FCLK_DIV5			11
+#define CLKID_FCLK_DIV7_DIV		12
+#define CLKID_FCLK_DIV7			13
+#define CLKID_FCLK_50M_DIV		14
+#define CLKID_FCLK_50M			15
+#define CLKID_PLL_PREDIV		16
+#define CLKID_GP0_PLL_DCO		17
+#define CLKID_GP0_PLL			18
+#define CLKID_HIFI_PLL_DCO		19
+#define CLKID_HIFI_PLL			20
+#define CLKID_HIFI1_PLL_DCO		21
+#define CLKID_HIFI1_PLL			22
+
+#endif /* __S7_PLL_CLKC_H */
