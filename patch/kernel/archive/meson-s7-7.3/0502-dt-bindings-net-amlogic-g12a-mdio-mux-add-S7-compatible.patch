From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Wed, 14 Oct 2026 14:08:27 +0300
Subject: [PATCH 502/503] dt-bindings: net: amlogic,g12a-mdio-mux: add S7
 compatible

The Amlogic S7 embeds the G12A MDIO multiplexer with a different PLL
for the internal PHY. Its 50 MHz input comes from the fixed PLL, not an
MPLL. Add a compatible for it.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 .../devicetree/bindings/net/amlogic,g12a-mdio-mux.yaml    | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/amlogic,g12a-mdio-mux.yaml b/Documentation/devicetree/bindings/net/amlogic,g12a-mdio-mux.yaml
index ec5c038ce..5b27a5fef 100644
--- a/Documentation/devicetree/bindings/net/amlogic,g12a-mdio-mux.yaml
+++ b/Documentation/devicetree/bindings/net/amlogic,g12a-mdio-mux.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/net/amlogic,g12a-mdio-mux.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: MDIO bus multiplexer/glue of Amlogic G12a SoC family
+title: MDIO bus multiplexer/glue of Amlogic G12a and S7 SoC families
 
 description:
   This is a special case of a MDIO bus multiplexer. It allows to choose between
@@ -19,7 +19,9 @@ allOf:
 
 properties:
   compatible:
-    const: amlogic,g12a-mdio-mux
+    enum:
+      - amlogic,g12a-mdio-mux
+      - amlogic,s7-mdio-mux
 
   reg:
     maxItems: 1
@@ -28,7 +30,7 @@ properties:
     items:
       - description: peripheral clock
       - description: platform crytal
-      - description: SoC 50MHz MPLL
+      - description: 50MHz clock of the internal PHY (MPLL on G12A, fixed PLL on S7)
 
   clock-names:
     items:
-- 
2.56.0

