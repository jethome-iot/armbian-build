From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Wed, 14 Oct 2026 15:05:55 +0300
Subject: [PATCH 504/506] clk: meson: s7: add S7 peripherals clock controller
 driver

Add the peripherals clock controller driver for the Amlogic S7 SoC
family (S805X3, S905Y5).

The register layout matches the S4 and T7 peripherals controllers. The
sys and axi clock trees are read-only: the firmware sets them up before
the kernel starts and the whole peripherals bus runs on them. The GP1
PLL comes from the firmware through SCMI.

The video clocks (vclk, encoders, HDMI TX, CVBS, LCD) are left out for
now: their PLL inputs are not described yet. The AXI bus gates are left
out too: their register bits are unknown.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 drivers/clk/meson/Kconfig          |   15 +
 drivers/clk/meson/Makefile         |    1 +
 drivers/clk/meson/s7-peripherals.c | 1316 ++++++++++++++++++++++++++++
 3 files changed, 1332 insertions(+)
 create mode 100644 drivers/clk/meson/s7-peripherals.c

diff --git a/drivers/clk/meson/Kconfig b/drivers/clk/meson/Kconfig
index efbdde9cd..c5397d5f6 100644
--- a/drivers/clk/meson/Kconfig
+++ b/drivers/clk/meson/Kconfig
@@ -243,6 +243,21 @@ config COMMON_CLK_S7_PLL
 	  GP0 and HiFi PLLs. Say Y if you want the board to work, because the
 	  PLLs are the parent of most peripherals.
 
+config COMMON_CLK_S7_PERIPHERALS
+	tristate "Amlogic S7 SoC peripherals clock controller support"
+	depends on ARM64
+	default ARCH_MESON
+	select COMMON_CLK_MESON_REGMAP
+	select COMMON_CLK_MESON_CLKC_UTILS
+	select COMMON_CLK_MESON_DUALDIV
+	imply COMMON_CLK_SCMI
+	imply COMMON_CLK_S7_PLL
+	help
+	  Support for the peripherals clock controller on Amlogic S805X3 and
+	  S905Y5 based devices, AKA S7. It provides the clocks of the MMC,
+	  Ethernet, I2C, UART, SPI, PWM and SAR ADC blocks. Say Y if you want
+	  the S7 peripherals clock controller to work.
+
 config COMMON_CLK_T7_PLL
 	tristate "Amlogic T7 SoC PLL controller support"
 	depends on ARM64
diff --git a/drivers/clk/meson/Makefile b/drivers/clk/meson/Makefile
index 9d439106d..1db3c4172 100644
--- a/drivers/clk/meson/Makefile
