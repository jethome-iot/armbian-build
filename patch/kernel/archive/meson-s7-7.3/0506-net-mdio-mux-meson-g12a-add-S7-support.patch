From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Wed, 14 Oct 2026 14:08:27 +0300
Subject: [PATCH 506/506] net: mdio: mux-meson-g12a: add S7 support

The S7 MDIO multiplexer drives the internal PHY from a PLL with a
different register layout. The register values and the delays come from
setup_internal_phy() in the Amlogic S7 vendor U-Boot. The sequence needs
delays between the steps, so the S7 PLL is prepared instead of enabled.
The PHY control register needs another state machine mode and three
undocumented bits.

The PHY ID register is programmable. Keep the G12A value, so the
internal PHY driver binds.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 drivers/net/mdio/mdio-mux-meson-g12a.c | 102 +++++++++++++++++++++++--
 1 file changed, 96 insertions(+), 6 deletions(-)

diff --git a/drivers/net/mdio/mdio-mux-meson-g12a.c b/drivers/net/mdio/mdio-mux-meson-g12a.c
index 08d6a6c93..f256928c8 100644
--- a/drivers/net/mdio/mdio-mux-meson-g12a.c
+++ b/drivers/net/mdio/mdio-mux-meson-g12a.c
@@ -21,6 +21,8 @@
 #define  PLL_CTL0_RST		BIT(29)
 #define  PLL_CTL0_EN		BIT(28)
 #define  PLL_CTL0_SEL		BIT(23)
+/* Undocumented. The S7 vendor U-Boot clears it last; set, it drops the lock */
+#define  PLL_CTL0_S7_BIT22	BIT(22)
 #define  PLL_CTL0_N		GENMASK(14, 10)
 #define  PLL_CTL0_M		GENMASK(8, 0)
 #define  PLL_LOCK_TIMEOUT	1000000
@@ -44,6 +46,10 @@
 #define  PHY_CNTL1_CLK_EN	BIT(16)
 #define  PHY_CNTL1_CLKFREQ	BIT(17)
 #define  PHY_CNTL1_PHY_ENB	BIT(18)
+/* Undocumented, set by the S7 vendor U-Boot */
+#define  PHY_CNTL1_S7_BIT8	BIT(8)
+#define  PHY_CNTL1_S7_BIT25	BIT(25)
+#define  PHY_CNTL1_S7_BIT30	BIT(30)
 #define ETH_PHY_CNTL2		0x88
 #define  PHY_CNTL2_USE_INTERNAL	BIT(5)
 #define  PHY_CNTL2_SMI_SRC_MAC	BIT(6)
@@ -52,10 +58,18 @@
 #define MESON_G12A_MDIO_EXTERNAL_ID 0
 #define MESON_G12A_MDIO_INTERNAL_ID 1
 
+struct g12a_mdio_mux_data {
+	const struct clk_ops *pll_ops;
+	u32 st_mode;		/* ETH_PHY_CNTL1 state machine mode */
+	u32 phy_cntl1_cfg;	/* extra ETH_PHY_CNTL1 bits */
+	u32 phy_cntl1_en;	/* ETH_PHY_CNTL1 bits that power the PHY up */
+};
+
 struct g12a_mdio_mux {
 	void __iomem *regs;
 	void *mux_handle;
 	struct clk *pll;
+	const struct g12a_mdio_mux_data *data;
 };
 
 struct g12a_ephy_pll {
@@ -147,6 +161,57 @@ static const struct clk_ops g12a_ephy_pll_ops = {
 	.init		= g12a_ephy_pll_init,
 };
 
+/*
+ * The S7 PLL has a different register layout and no documentation. The
+ * register values and the delays are verbatim from setup_internal_phy()
+ * in the Amlogic S7 vendor U-Boot; bits 15 and 22 of ETH_PLL_CTL0 are
+ * undocumented. The sequence sleeps, so it runs from the prepare
+ * callback; __clk_is_enabled() then falls back to the enable count. The
+ * rate fields are unknown, so the clock reports the rate of its parent.
+ */
+static void s7_ephy_pll_unprepare(struct clk_hw *hw)
+{
+	struct g12a_ephy_pll *pll = g12a_ephy_pll_to_dev(hw);
+	u32 val;
+
+	val = readl(pll->base + ETH_PLL_CTL0);
+	val |= PLL_CTL0_S7_BIT22;
+	writel(val, pll->base + ETH_PLL_CTL0);
+}
+
+static int s7_ephy_pll_prepare(struct clk_hw *hw)
+{
+	struct g12a_ephy_pll *pll = g12a_ephy_pll_to_dev(hw);
+	u32 val;
+	int ret;
+
+	writel(0x00510630, pll->base + ETH_PLL_CTL0);
+	writel(0x222210a0, pll->base + ETH_PLL_CTL1);
+	writel(0x00518630, pll->base + ETH_PLL_CTL0);
+	usleep_range(200, 300);
+	writel(0x222200a0, pll->base + ETH_PLL_CTL1);
+	usleep_range(200, 300);
+	writel(0x00118630, pll->base + ETH_PLL_CTL0);
+	usleep_range(800, 1000);
+	writel(0xaa860000, pll->base + ETH_PLL_CTL3);
+	writel(0x00004001, pll->base + ETH_PLL_CTL6);
+	writel(0x20000000, pll->base + ETH_PLL_CTL5);
+	writel(0x00000023, pll->base + ETH_PLL_CTL7);
+
+	ret = readl_poll_timeout(pll->base + ETH_PLL_CTL0, val,
+				 val & PLL_CTL0_LOCK_DIG, 1000, PLL_LOCK_TIMEOUT);
+	if (ret)
+		s7_ephy_pll_unprepare(hw);
+
+	return ret;
+}
+
+static const struct clk_ops s7_ephy_pll_ops = {
+	.is_prepared	= g12a_ephy_pll_is_enabled,
+	.prepare	= s7_ephy_pll_prepare,
+	.unprepare	= s7_ephy_pll_unprepare,
+};
+
 static int g12a_enable_internal_mdio(struct g12a_mdio_mux *priv)
 {
 	u32 value;
@@ -163,18 +228,19 @@ static int g12a_enable_internal_mdio(struct g12a_mdio_mux *priv)
 	writel(EPHY_G12A_ID, priv->regs + ETH_PHY_CNTL0);
 
 	/* Make sure we get a 0 -> 1 transition on the enable bit */
-	value = FIELD_PREP(PHY_CNTL1_ST_MODE, 3) |
+	value = FIELD_PREP(PHY_CNTL1_ST_MODE, priv->data->st_mode) |
 		FIELD_PREP(PHY_CNTL1_ST_PHYADD, EPHY_DFLT_ADD) |
 		FIELD_PREP(PHY_CNTL1_MII_MODE, EPHY_MODE_RMII) |
 		PHY_CNTL1_CLK_EN |
-		PHY_CNTL1_CLKFREQ;
+		PHY_CNTL1_CLKFREQ |
+		priv->data->phy_cntl1_cfg;
 	writel(value, priv->regs + ETH_PHY_CNTL1);
 	writel(PHY_CNTL2_USE_INTERNAL |
 	       PHY_CNTL2_SMI_SRC_MAC |
 	       PHY_CNTL2_RX_CLK_EPHY,
 	       priv->regs + ETH_PHY_CNTL2);
 
-	value |= PHY_CNTL1_PHY_ENB;
+	value |= priv->data->phy_cntl1_en;
 	writel(value, priv->regs + ETH_PHY_CNTL1);
 
 	/* The phy needs a bit of time to power up */
@@ -213,8 +279,30 @@ static int g12a_mdio_switch_fn(int current_child, int desired_child,
 	}
 }
 
+static const struct g12a_mdio_mux_data g12a_data = {
+	.pll_ops	= &g12a_ephy_pll_ops,
+	.st_mode	= 3,
+	.phy_cntl1_en	= PHY_CNTL1_PHY_ENB,
+};
+
+/* The mode and the extra bits are undocumented, from the S7 vendor U-Boot */
+static const struct g12a_mdio_mux_data s7_data = {
+	.pll_ops	= &s7_ephy_pll_ops,
+	.st_mode	= 7,
+	.phy_cntl1_cfg	= PHY_CNTL1_S7_BIT8,
+	.phy_cntl1_en	= PHY_CNTL1_PHY_ENB | PHY_CNTL1_S7_BIT25 |
+			  PHY_CNTL1_S7_BIT30,
+};
+
 static const struct of_device_id g12a_mdio_mux_match[] = {
-	{ .compatible = "amlogic,g12a-mdio-mux", },
+	{
+		.compatible = "amlogic,g12a-mdio-mux",
+		.data = &g12a_data,
+	},
+	{
+		.compatible = "amlogic,s7-mdio-mux",
+		.data = &s7_data,
+	},
 	{},
 };
 MODULE_DEVICE_TABLE(of, g12a_mdio_mux_match);
@@ -280,7 +368,7 @@ static int g12a_ephy_glue_clk_register(struct device *dev)
 		return -ENOMEM;
 
 	init.name = name;
-	init.ops = &g12a_ephy_pll_ops;
+	init.ops = priv->data->pll_ops;
 	init.flags = 0;
 	parent_names[0] = __clk_get_name(clk);
 	init.parent_names = parent_names;
@@ -314,6 +402,8 @@ static int g12a_mdio_mux_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, priv);
 
+	priv->data = device_get_match_data(dev);
+
 	priv->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(priv->regs))
 		return PTR_ERR(priv->regs);
@@ -356,6 +446,6 @@ static struct platform_driver g12a_mdio_mux_driver = {
 };
 module_platform_driver(g12a_mdio_mux_driver);
 
-MODULE_DESCRIPTION("Amlogic G12a MDIO multiplexer driver");
+MODULE_DESCRIPTION("Amlogic G12a and S7 MDIO multiplexer driver");
 MODULE_AUTHOR("Jerome Brunet <jbrunet@baylibre.com>");
 MODULE_LICENSE("GPL v2");
-- 
2.56.0

